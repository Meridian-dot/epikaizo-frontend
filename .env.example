# Copy this file to .env.local and fill in the values.

# Base URL of the backend Express API (separate repo), no trailing slash.
# Used on the server only. Example: http://localhost:4000
API_URL=http://localhost:4000

# "true" = pages use the mock data in src/mocks (no backend needed).
# "false" = read rooms, menu, page text and settings from the API (needs the API running).
# Same name as the admin dashboard (Docking Spec section 10).
NEXT_PUBLIC_USE_MOCKS=true
